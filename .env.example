# ==============================================================================
# LLM Provider Chain (generic ordered list, no provider names hard-coded)
# Add or swap providers by changing these variables. The pipeline tries each
# provider in order (1 -> 2 -> 3) on daily quota exhaustion or circuit break.
# A missing key means that provider is skipped silently.
# ==============================================================================

# Provider 1 (Primary) - Gemini via Google AI Studio
# Free tier: ~500 requests per day. Checked 21 Sep 2026.
LLM_PROVIDER_1_NAME=gemini
LLM_PROVIDER_1_API_KEY=your_gemini_api_key_here
LLM_PROVIDER_1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER_1_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER_1_RPM=15
LLM_PROVIDER_1_TPM=1000000
LLM_PROVIDER_1_CONCURRENCY=2

# Provider 2 (Fallback, optional) - Mistral via api.mistral.ai/v1 (OpenAI-compatible)
# Free mode on by default for new accounts. No fixed daily limit published.
# Tracker reports ~1 request/second. Turn off training data use in Admin Console.
# Verify Indian phone number works at signup before building against this key.
LLM_PROVIDER_2_NAME=mistral
LLM_PROVIDER_2_API_KEY=
LLM_PROVIDER_2_BASE_URL=https://api.mistral.ai/v1
LLM_PROVIDER_2_MODEL=mistral-small-latest
LLM_PROVIDER_2_RPM=60
LLM_PROVIDER_2_TPM=500000
LLM_PROVIDER_2_CONCURRENCY=1

# Provider 3 (Second fallback, optional) - GLM-4.7-Flash via api.z.ai (international)
# Priced at free on the international portal (email signup only).
# Concurrency limit of 1. Do not use GLM-4.5 (being retired).
LLM_PROVIDER_3_NAME=glm
LLM_PROVIDER_3_API_KEY=
LLM_PROVIDER_3_BASE_URL=https://api.z.ai/api/paas/v4
LLM_PROVIDER_3_MODEL=glm-4-flash
LLM_PROVIDER_3_RPM=30
LLM_PROVIDER_3_TPM=200000
LLM_PROVIDER_3_CONCURRENCY=1

# LLM behaviour settings (apply to all providers)
# LLM_DEV_CACHE=true stores responses in .cache/llm/ keyed by prompt hash.
# Use during debugging to avoid burning daily quota. NEVER set in production.
LLM_DEV_CACHE=false

# ==============================================================================
# Crawler & Security Settings
# ==============================================================================

# Allow fetching localhost and private IP ranges. Set to true only inside the
# CLI process (evaluate.ts sets it automatically). Never set in production.
ALLOW_PRIVATE_HOSTS=false

# Maximum pages the crawler fetches per company site.
CRAWL_MAX_PAGES=10

# ==============================================================================
# Database & Server (packages/server)
# ==============================================================================

MONGODB_URI=mongodb://localhost:27017/ai_prep_kit
SESSION_SECRET=development_session_secret_change_in_production
CLIENT_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# ==============================================================================
# Frontend (packages/web)
# ==============================================================================

# Backend URL used by the browser when not using the Next.js proxy.
# In production, leave this empty and use Next.js rewrites to proxy /api/*.
NEXT_PUBLIC_API_URL=http://localhost:4000
